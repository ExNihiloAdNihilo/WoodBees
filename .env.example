# Copy this file to .env (uncommitted) before running `docker compose up`.
# There is no default - DB_MODE must be set to one of:
#
#   mariadb   docker compose provisions MariaDB 11.4 for you.
#   mysql     docker compose provisions MySQL 8.4 for you.
#   external  you already run your own MariaDB/MySQL server. docker compose
#             will NOT start a database container at all; instead point
#             forum/include/config.inc.php's $db_server/$db_port/$db_username/
#             etc at your server (the installer's "Reconnect" method rewrites
#             this file for you without touching existing data).
#
# Tested end-to-end as of 2026-11-13 (fresh installs against mariadb, mysql,
# and external, plus the missing-.env and missing-DB_IMAGE failure cases).
DB_MODE=

# --- Required when DB_MODE is mariadb or mysql (ignored for external) ---
#
# Both of the following are tested and supported:
#DB_IMAGE=mariadb:11.4
#DB_IMAGE=mysql:8.4
#
# Compose profile that actually starts the bundled database service - must
# be set to "db" for mariadb/mysql mode, left unset for external mode:
#COMPOSE_PROFILES=db
#
# Switching engines after the forum has data needs a fresh DB volume -
# the two engines don't share an on-disk format:
#   docker compose down
#   docker volume rm $(docker volume ls -q --filter name=db_data)
#   docker compose up -d
#
# Switching DB_MODE itself (bundled <-> external) changes which services are
# active, but Compose won't remove a container just because it dropped out
# of the active profile - the old mysql container can keep running
# unnoticed. Run this first when switching:
#   docker compose down --remove-orphans
#
# Easier than typing these out: the install wizard page has Copy buttons for
# both commands, and scripts/switch-db-engine.sh (or .ps1 on Windows) runs
# the whole sequence for you with confirmation prompts - see the readme's
# "Database engine" section.

# --- Optional, DB_MODE=external only ---
#
# Manticore (if you use it) needs to reach your external DB too. Defaults
# below target the bundled mysql service; override for your own server:
#MANTICORE_DB_HOST=
#MANTICORE_DB_PORT=
#MANTICORE_DB_USER=
#MANTICORE_DB_PASS=
#MANTICORE_DB_NAME=
