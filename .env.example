# Copy this file to .env (uncommitted) before running `docker compose up`.
# There is no default - pick exactly ONE engine by uncommenting one
# COMPOSE_FILE line below. The file you pick is the database engine:
#
#   mariadb   docker compose provisions MariaDB 11.4 for you.
#   mysql     docker compose provisions MySQL 8.4 for you.
#   external  you already run your own MariaDB/MySQL server. docker compose
#             will NOT start a database container at all; instead point
#             forum/include/config.inc.php at your server by running the
#             installer (its "Reconnect" method rewrites that file without
#             touching existing data), and fill in the Manticore section below.
#
# Needs Docker Compose v2 (the "docker compose" command, not "docker-compose").

# Separator between the file names in COMPOSE_FILE. Compose defaults to ";" on
# Windows and ":" elsewhere; pinning it keeps these lines identical everywhere.
COMPOSE_PATH_SEPARATOR=:

#COMPOSE_FILE=docker-compose.yml:docker-compose.mariadb.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.mysql.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.external.yml

# Switching engines after the forum has data: MariaDB and MySQL don't share an
# on-disk format, so going between the two bundled engines needs a fresh DB
# volume. -v deletes this project's volumes only (database + Manticore index,
# which rebuilds itself):
#   docker compose down -v
#   (edit COMPOSE_FILE above)
#   docker compose up -d
#
# Switching to or from external changes which services exist, but Compose won't
# remove a container just because it dropped out of the file set - the old
# mysql container can keep running unnoticed. Run this after editing
# COMPOSE_FILE:
#   docker compose down --remove-orphans
#
# Easier than typing these out: the install wizard page has Copy buttons for
# both commands, and scripts/switch-db-engine.sh (or .ps1 on Windows) runs
# the whole sequence for you with confirmation prompts - see the readme's
# "Database engine" section.

# --- Required for the external engine file only (ignored otherwise) ---
#
# Manticore (the search server) connects to your database straight from its
# own container, so it needs the same details config.inc.php has:
#MANTICORE_DB_HOST=
#MANTICORE_DB_PORT=3306
#MANTICORE_DB_USER=
#MANTICORE_DB_PASS=
#MANTICORE_DB_NAME=
